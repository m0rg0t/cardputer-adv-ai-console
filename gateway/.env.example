VOICE_DEVICE_TOKEN=replace-with-a-long-random-device-token
VOICE_MAX_UPLOAD_BYTES=134217728
TRANSCRIPTION_TIMEOUT_SECONDS=1800
OBSIDIAN_VAULT_ROOT=/absolute/path/to/your/Obsidian/Vault
OBSIDIAN_NOTES_FOLDER='Inbox/Cardputer Voice'
OBSIDIAN_AUDIO_FORMAT=mp3
FFMPEG_EXECUTABLE=ffmpeg

# Local macOS speech for Codex replies (no text leaves this Mac).
TTS_ENABLED=true
TTS_VOICE=Milena
TTS_RATE=190
TTS_MAX_CHARS=6000
SAY_EXECUTABLE=/usr/bin/say

# mock | openai | faster-whisper | whisper-server
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
WHISPER_MODEL=small
WHISPER_SERVER_URL=http://127.0.0.1:12017
WHISPER_SERVER_MODEL=medium-q5_0
WHISPER_SERVER_LANGUAGE=ru
WHISPER_SERVER_API_KEY=
OPENAI_API_KEY=

# Access existing local Codex Desktop/CLI threads through `codex app-server`.
CODEX_ENABLED=true
CODEX_EXECUTABLE=codex
CODEX_DEFAULT_CWD=/absolute/path/to/your/projects

# Optional OpenAI-compatible/Hermes formatter for Obsidian notes.
# none | codex-exec | openai-compatible
TRANSCRIPT_FORMATTER=codex-exec
CODEX_FORMATTER_TIMEOUT_SECONDS=180
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=

# Bonjour discovery advertised to Cardputer devices on the LAN.
GATEWAY_ADVERTISE_MDNS=true
GATEWAY_ADVERTISE_PORT=8765
